<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="InventoryManagerApp.MainPage"
             Title="Login">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="20">

            <Label
                Text="Steven McGraw"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="WeeK 4 Performance Assessment"
                FontSize="20"
                HorizontalOptions="Center" />

            <Entry
                x:Name="txtUserName"
                Placeholder="User Name" />

            <Entry
                x:Name="txtPassword"
                Placeholder="Password"
                IsPassword="True" />

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">

                <Button
                    Grid.Column="0"
                    Text="Login"
                    Clicked="OnLoginClicked" />

                <Button
                    Grid.Column="1"
                    Text="Cancel"
                    Clicked="OnCancelClicked" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>